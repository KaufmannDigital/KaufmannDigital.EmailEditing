prototype(KaufmannDigital.EmailEditing:Component.Text) < prototype(Neos.Fusion:Component) {

  content = null
  fontColor = ${FallbackValue.getFallbackValue(node, 'textFontColor')}
  fontFamily = ${FallbackValue.getFallbackValue(node, 'textFontFamily')}
  fontSize = ${FallbackValue.getFallbackValue(node, 'textFontSize')}
  fontStyle = ${FallbackValue.getFallbackValue(node, 'textFontStyle')}
  fontWeight = ${FallbackValue.getFallbackValue(node, 'textFontWeight')}
  lineHeight = ${FallbackValue.getFallbackValue(node, 'textLineHeight')}
  letterSpacing = ${FallbackValue.getFallbackValue(node, 'textLetterSpacing')}
  textDecoration = ${FallbackValue.getFallbackValue(node, 'textTextDecoration')}
  textTransform = ${FallbackValue.getFallbackValue(node, 'textTextTransform')}
  textAlign = ${FallbackValue.getFallbackValue(node, 'textTextAlign')}
  padding = ${FallbackValue.getFallbackValue(node, 'textPadding')}
  backgroundColor = null
  cssClass = null
  cssClass.@process.append = ${value ? value + ' mj-text' : 'mj-text'}

  renderer = afx`
    <mj-text
      color={props.fontColor}
      font-family={props.fontFamily}
      font-size={props.fontSize}
      font-style={props.fontStyle}
      font-weight={props.fontWeight}
      line-height={props.lineHeight}
      letter-spacing={props.letterSpacing}
      text-decoration={props.textDecoration}
      text-transform={props.textTransform}
      align={props.textAlign}
      padding={props.padding}
      container-background-color={props.backgroundColor}
      css-class={props.cssClass}
    >
      {props.content}
    </mj-text>
  `
}
