prototype(KaufmannDigital.EmailEditing:Component.Divider) < prototype(Neos.Fusion:Component) {

  borderColor = ${FallbackValue.getFallbackValue(node, 'dividerBorderColor')}
  borderStyle = ${FallbackValue.getFallbackValue(node, 'dividerBorderStyle')}
  borderWidth = ${FallbackValue.getFallbackValue(node, 'dividerBorderWidth')}
  padding = ${FallbackValue.getFallbackValue(node, 'dividerPadding')}

  renderer = afx`
    <mj-divider
      border-color={props.borderColor}
      border-style={props.borderStyle}
      border-width={props.borderWidth + 'px'}
      padding={props.padding}
    />
  `

}
