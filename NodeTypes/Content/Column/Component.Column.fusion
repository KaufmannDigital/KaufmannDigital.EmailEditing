prototype(KaufmannDigital.EmailEditing:Component.Column) < prototype(Neos.Fusion:Component) {
  content = null

  backgroundColor = ${FallbackValue.getFallbackValue(node, 'columnBackgroundColor')}
  padding = ${FallbackValue.getFallbackValue(node, 'columnPadding')}
  width = '100%'

  renderer = afx`
    <mj-column
      background-color={props.backgroundColor}
      padding={props.padding}
      width={props.width}
      vertical-align="middle"
    >
      {props.content}
    </mj-column>
  `
}
