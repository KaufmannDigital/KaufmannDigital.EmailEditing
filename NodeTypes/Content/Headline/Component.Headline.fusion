prototype(KaufmannDigital.EmailEditing:Component.Headline) < prototype(KaufmannDigital.EmailEditing:MjmlComponent) {

  fontColor = ${FallbackValue.getFallbackValue(node, 'headlineFontColor')}
  fontFamily = ${FallbackValue.getFallbackValue(node, 'headlineFontFamily')}
  fontSize = ${FallbackValue.getFallbackValue(node, 'headlineFontSize')}
  fontStyle = ${FallbackValue.getFallbackValue(node, 'headlineFontStyle')}
  fontWeight = ${FallbackValue.getFallbackValue(node, 'headlineFontWeight')}
  lineHeight = ${FallbackValue.getFallbackValue(node, 'headlineLineHeight')}
  letterSpacing = ${FallbackValue.getFallbackValue(node, 'headlineLetterSpacing')}
  textDecoration = ${FallbackValue.getFallbackValue(node, 'headlineTextDecoration')}
  textTransform = ${FallbackValue.getFallbackValue(node, 'headlineTextTransform')}
  textAlign = ${FallbackValue.getFallbackValue(node, 'headlineTextAlign')}
  align = null
  padding = ${FallbackValue.getFallbackValue(node, 'headlinePadding')}
  backgroundColor = null
  headline = null
  cssClass = null
  id = null


  renderer = afx`
    <mj-raw @if.condition={props.id}><div id={props.id}></div></mj-raw>
    <mj-text
      color={props.fontColor}
      font-family={props.fontFamily}
      font-size={props.fontSize}
      font-style={props.fontStyle}
      font-weight={props.fontWeight}
      line-height={props.lineHeight}
      letter-spacing={props.letterSpacing}
      text-decoration={props.textDecoration}
      text-transform={props.textTransform}
      align={props.textAlign}
      padding={props.padding}
      container-background-color={props.backgroundColor}
      css-class={props.cssClass}
    >
      {props.headline}
    </mj-text>
  `
}
