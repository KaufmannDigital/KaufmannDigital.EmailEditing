<?xml version="1.0" encoding="UTF-8"?>
<xliff version="1.2" xmlns="urn:oasis:names:tc:xliff:document:1.2">
    <file original="" product-name="KaufmannDigital.EmailEditing" source-language="en" target-language="de" datatype="plaintext">
        <body>
            <trans-unit id="ui.label" xml:space="preserve">
                <source>Column</source>
                <target>Spalte</target>
            </trans-unit>
            <trans-unit id="properties.textFontColor" xml:space="preserve">
                <source>Text font color</source>
                <target>Textfarbe</target>
            </trans-unit>
            <trans-unit id="properties.textFontColor.ui.help.message" xml:space="preserve">
                <source>Overrides the text color for all text elements within this column. Takes priority over the section setting.</source>
                <target>Überschreibt die Schriftfarbe für alle Textelemente in dieser Spalte. Hat Vorrang vor der Section-Einstellung.</target>
            </trans-unit>
            <trans-unit id="properties.headlineFontColor" xml:space="preserve">
                <source>Headline font color</source>
                <target>Überschriftenfarbe</target>
            </trans-unit>
            <trans-unit id="properties.headlineFontColor.ui.help.message" xml:space="preserve">
                <source>Overrides the headline color for all headline elements within this column. Takes priority over the section setting.</source>
                <target>Überschreibt die Schriftfarbe für alle Überschriften in dieser Spalte. Hat Vorrang vor der Section-Einstellung.</target>
            </trans-unit>
            <trans-unit id="properties.verticalAlign" xml:space="preserve">
                <source>Vertical Alignment</source>
                <target>Vertikale Ausrichtung</target>
            </trans-unit>
            <trans-unit id="properties.verticalAlign.ui.help.message" xml:space="preserve">
                <source>Vertical alignment of this column within the section. If empty, the value of the email layout is used.</source>
                <target>Vertikale Ausrichtung dieser Spalte innerhalb der Section. Wenn leer, wird der Wert aus dem E-Mail-Layout verwendet.</target>
            </trans-unit>
            <trans-unit id="properties.verticalAlign.selectBoxEditor.placeholder" xml:space="preserve">
                <source>Please choose...</source>
                <target>Bitte wählen...</target>
            </trans-unit>
            <trans-unit id="properties.verticalAlign.selectBoxEditor.values.top" xml:space="preserve">
                <source>Top</source>
                <target>Oben</target>
            </trans-unit>
            <trans-unit id="properties.verticalAlign.selectBoxEditor.values.middle" xml:space="preserve">
                <source>Middle</source>
                <target>Mitte</target>
            </trans-unit>
            <trans-unit id="properties.verticalAlign.selectBoxEditor.values.bottom" xml:space="preserve">
                <source>Bottom</source>
                <target>Unten</target>
            </trans-unit>
        </body>
    </file>
